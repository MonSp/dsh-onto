# 部署配置模板（api-to-plugin S2.4）：真实地址/凭据只填在部署侧 env，不入包、不入生成物源码。
# 数据源（缺省不登记数据源，sourceId 运行拒绝）
__ENV_API_URL__=http://127.0.0.1:3912
# 可选：formal 走业务来源语义（缺省 simulated）
# __ENV_API_KIND__=formal
# 可选：静态 Bearer 令牌（不落日志）
# __ENV_API_TOKEN__=

# 业务身份（缺一不可，否则身份解析为 null）
DSH_BIZ_USER_ID=user-__DOMAIN_LOWER__
DSH_BIZ_TENANT=tenant-__DOMAIN_LOWER__
DSH_BIZ_ROLES=analyst
DSH_BIZ_SCOPE_TYPES=__SCOPE_TYPES__
